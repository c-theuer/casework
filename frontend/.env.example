# Copy to frontend/.env and adjust if needed. Never commit .env.
# Vite only exposes variables prefixed VITE_ to client code (see src/api.ts).

# Must be reachable from the browser, not from inside a docker network --
# use http://localhost:8000 even when the backend runs via docker-compose,
# since it's your browser (on the host), not the frontend container, that
# calls this URL.
VITE_API_BASE_URL=http://localhost:8000
