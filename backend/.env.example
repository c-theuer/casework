# Copy to backend/.env and fill in real values. Never commit .env.

# --- Anthropic (Claude Agent SDK) ---
ANTHROPIC_API_KEY=

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_...

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-...
# Team ID starts with 'T' -- Slack Admin -> Settings -> "About this workspace",
# or the workspace URL/ID lookup at slack.com/help/articles/221769328.
SLACK_TEAM_ID=T...
SLACK_FRAUD_OPS_CHANNEL=#fraud-ops

# --- GitHub ---
GITHUB_PAT=ghp_...
GITHUB_DEMO_REPO=your-username/casework-demo

# --- Database ---
# Local dev / integration tests. Leave both unset in Cloud Run -- config.py
# falls back to the /cloudsql/<PROJECT>:<REGION>:<INSTANCE> unix socket
# instead (see CLOUD_SQL_CONNECTION_NAME below).
DATABASE_URL=postgresql://casework:casework@localhost:5434/casework
TEST_DATABASE_URL=postgresql://casework:casework@localhost:5433/casework_test

# --- Cloud SQL (Cloud Run only, leave blank for local dev) ---
CLOUD_SQL_CONNECTION_NAME=
DB_USER=casework
DB_PASSWORD=casework
DB_NAME=casework

# --- CORS ---
# Origin of the frontend app (see frontend/.env.example for its own config).
FRONTEND_ORIGIN=http://localhost:5173
